{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tnt-zockt-qvj3.vercel.app"
        }
      ],
      "destination": "https://tnt-zockt.ch/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/world-subs",
      "destination": "/api/world-ticket"
    },
    {
      "source": "/api/world-casinos",
      "destination": "/api/world-ticket?casinos=1"
    },
    {
      "source": "/api/world-casino-consent",
      "destination": "/api/world-ticket?consent=1"
    }
  ]
}
